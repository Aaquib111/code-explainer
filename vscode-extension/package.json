{
	"name": "code-explainer",
	"displayName": "Code Explainer",
	"description": "Agent-created code walkthroughs with editor highlighting and macOS narration.",
	"version": "0.3.0",
	"publisher": "srujangurram",
	"icon": "media/icon.png",
	"engines": {
		"vscode": "^1.85.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./out/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "codeExplainer.togglePlayPause",
				"title": "Code Explainer: Toggle Play/Pause"
			},
			{
				"command": "codeExplainer.next",
				"title": "Code Explainer: Next Highlight"
			},
			{
				"command": "codeExplainer.prev",
				"title": "Code Explainer: Previous Highlight"
			},
			{
				"command": "codeExplainer.stop",
				"title": "Code Explainer: Stop Walkthrough"
			},
			{
				"command": "codeExplainer.speedUp",
				"title": "Code Explainer: Speed Up"
			},
			{
				"command": "codeExplainer.speedDown",
				"title": "Code Explainer: Speed Down"
			}
		],
		"keybindings": [
			{
				"command": "codeExplainer.togglePlayPause",
				"key": "ctrl+shift+space",
				"when": "codeExplainer.walkthroughActive"
			},
			{
				"command": "codeExplainer.next",
				"key": "ctrl+shift+]",
				"when": "codeExplainer.walkthroughActive"
			},
			{
				"command": "codeExplainer.prev",
				"key": "ctrl+shift+[",
				"when": "codeExplainer.walkthroughActive"
			},
			{
				"command": "codeExplainer.stop",
				"key": "ctrl+shift+\\",
				"when": "codeExplainer.walkthroughActive"
			},
			{
				"command": "codeExplainer.speedUp",
				"key": "ctrl+shift+=",
				"when": "codeExplainer.walkthroughActive"
			},
			{
				"command": "codeExplainer.speedDown",
				"key": "ctrl+shift+-",
				"when": "codeExplainer.walkthroughActive"
			}
		],
		"viewsContainers": {
			"activitybar": [
				{
					"id": "code-explainer",
					"title": "Code Explainer",
					"icon": "media/icon.svg"
				}
			]
		},
		"views": {
			"code-explainer": [
				{
					"type": "webview",
					"id": "codeExplainer.sidebar",
					"name": "Code Explainer"
				}
			]
		}
	},
	"scripts": {
		"compile": "esbuild src/extension.ts --bundle --platform=node --target=node18 --outfile=out/extension.js --external:vscode --format=cjs --sourcemap",
		"watch": "npm run compile -- --watch",
		"check": "tsc --noEmit",
		"test": "esbuild test/core.test.ts --bundle --platform=node --target=node18 --outfile=test/out/core.test.js && node --test test/out/core.test.js",
		"package": "npm run check && npm run compile -- --minify && vsce package --no-dependencies --allow-missing-repository"
	},
	"devDependencies": {
		"@types/node": "^20.11.0",
		"@types/vscode": "^1.85.0",
		"@vscode/vsce": "^3.9.2",
		"esbuild": "^0.28.1",
		"typescript": "^5.3.0"
	}
}
